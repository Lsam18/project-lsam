// Minimal admin server to append projects to assets/projects.json
// Requires: npm install express

const express = require('express');
const fs = require('fs');
const path = require('path');
const bodyParser = require('body-parser');

const app = express();
const PORT = process.env.PORT || 3000;

const ADMIN_TOKEN = process.env.ADMIN_TOKEN || null; // set Admin token via env var

app.use(bodyParser.json({ limit: '1mb' }));
app.use(express.static(path.join(__dirname)));

function sendErr(res, code, msg) {
  return res.status(code).json({ ok: false, error: msg });
}

function validateProject(obj) {
  if (!obj || typeof obj !== 'object') return 'Invalid payload';
  if (!obj.title || typeof obj.title !== 'string') return 'Missing title';
  if (!obj.description || typeof obj.description !== 'string') return 'Missing description';
  if (!Array.isArray(obj.categories) || obj.categories.length === 0) return 'At least one category is required';
  // optional: long_description, skills (array), images (array), date
  return null;
}

app.post('/api/projects', (req, res) => {
  // simple token check
  const auth = req.get('authorization') || '';
  if (!ADMIN_TOKEN) return sendErr(res, 500, 'Server not configured: ADMIN_TOKEN not set');
  if (!auth.startsWith('Bearer ')) return sendErr(res, 401, 'Missing Bearer token');
  const token = auth.slice(7).trim();
  if (token !== ADMIN_TOKEN) return sendErr(res, 403, 'Invalid token');

  const payload = req.body;
  const vErr = validateProject(payload);
  if (vErr) return sendErr(res, 400, vErr);

  const jsonPath = path.join(__dirname, 'assets', 'projects.json');
  try {
    const raw = fs.readFileSync(jsonPath, 'utf8');
    const projects = JSON.parse(raw);
    
    // Add new project at the start
    projects.unshift(payload);

    // Separate recent and older projects
    const recentProjects = projects.slice(0, 4);  // Keep only 4 most recent
    const olderProjects = projects.slice(4);      // Rest of the projects

    // backup current file with timestamp
    const bakPath = jsonPath + '.' + Date.now() + '.bak';
    fs.writeFileSync(bakPath, raw, 'utf8');

    // Write back all projects, with recent ones first
    fs.writeFileSync(jsonPath, JSON.stringify([...recentProjects, ...olderProjects], null, 2), 'utf8');

    res.json({ ok: true, backup: path.basename(bakPath) });
  } catch (err) {
    console.error('Error updating projects:', err);
    sendErr(res, 500, 'Failed to update projects file');
  }
});

app.listen(PORT, () => {
  console.log('Admin server running on http://localhost:' + PORT);
});
